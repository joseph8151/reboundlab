# ─────────────────────────────────────────────
# 사이트 기본 정보
# ─────────────────────────────────────────────
# 배포 주소(끝에 / 없이). SEO canonical, OG에 사용됩니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 사이트 한글 이름. 코드에 기본값(멜리사 에듀)이 있어 비워 둬도 됩니다. 영문 표기 MELISSA EDU는 src/lib/site.ts에 있습니다.
NEXT_PUBLIC_BRAND_NAME=멜리사 에듀

# ─────────────────────────────────────────────
# 운영자 입력 정보 (비워 두면 화면에 표시되지 않습니다)
# 전자상거래법상 표시 의무 항목이므로 판매 시작 전에 반드시 채우세요.
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BIZ_COMPANY=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=
# 이용약관·개인정보처리방침·환불 정책의 법률 검토를 마치면 true (초안 안내 문구가 사라집니다)
NEXT_PUBLIC_LEGAL_REVIEWED=false
# 상담 신청이 전송되는 Formspree 폼 주소. 우선순위: PUBLIC_FORMSPREE_ENDPOINT > NEXT_PUBLIC_FORMSPREE_ENDPOINT > NEXT_PUBLIC_FORMSPREE_URL > 코드 기본값
PUBLIC_FORMSPREE_ENDPOINT=
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mwlvwoev
# 수능 D-day 기준일 (평가원 시행계획 공고로 확인)
NEXT_PUBLIC_SUNEUNG_DATE=2026-11-19
# AI 멜리사 GPT 주소 (비워 두면 기본 주소 사용)
NEXT_PUBLIC_AI_TUTOR_URL=

# ─────────────────────────────────────────────
# Supabase (Project Settings → API)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────
# 관리자 (쉼표로 여러 명)
# ─────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ─────────────────────────────────────────────
# AI 지문 분석 (/study/ai-melisa) — Anthropic Claude
# ─────────────────────────────────────────────
# console.anthropic.com에서 발급. 비워 두면 사이트 안 분석은 꺼지고 GPT 링크만 보입니다.
# 서버 전용 키입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
ANTHROPIC_API_KEY=
# 사용자 1명당 하루 분석 횟수 (비용 관리)
AI_DAILY_LIMIT=5

