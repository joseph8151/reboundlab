# ─────────────────────────────────────────────
# 사이트 기본 정보
# ─────────────────────────────────────────────
# 배포 주소(끝에 / 없이). SEO canonical, OG, 결제 성공/실패 URL에 사용됩니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 사이트 이름. 코드에 기본값(멜리사 에듀)이 있어 비워 둬도 되고, 바꾸고 싶을 때만 넣으세요.
NEXT_PUBLIC_BRAND_NAME=멜리사 에듀
# 상담 신청이 전송되는 Formspree 폼 주소 (기본값이 코드에 들어 있어 비워 둬도 됩니다)
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/mwlvwoev
# 수능 D-day 기준일 (평가원 시행계획 공고로 확인)
NEXT_PUBLIC_SUNEUNG_DATE=2026-11-19
# AI 멜리사 GPT 주소 (비워 두면 기본 주소 사용)
NEXT_PUBLIC_AI_TUTOR_URL=

# ─────────────────────────────────────────────
# Supabase (Project Settings → API)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────
# 토스페이먼츠 결제위젯 (개발자센터 → API 키 → 결제위젯 연동 키)
# 아래 값은 토스페이먼츠 공식 문서에 공개된 테스트용 키입니다.
# 실제 결제는 일어나지 않으며, 본인 상점의 테스트 키(test_gck_/test_gsk_)로 바꿔 쓰는 것을 권장합니다.
# ─────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# ─────────────────────────────────────────────
# 다운로드 정책
# ─────────────────────────────────────────────
# 결제일로부터 다운로드 가능한 기간(일)
DOWNLOAD_VALID_DAYS=365
# 주문 1건당 최대 다운로드 횟수
DOWNLOAD_MAX_COUNT=5
# 서명 URL 유효 시간(초). 짧을수록 링크 공유가 어렵습니다.
DOWNLOAD_URL_TTL_SECONDS=60

# ─────────────────────────────────────────────
# 관리자 (쉼표로 여러 명)
# ─────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ─────────────────────────────────────────────
# AI 지문 분석 (/study/ai-melisa) — Anthropic Claude
# ─────────────────────────────────────────────
# console.anthropic.com에서 발급. 비워 두면 사이트 안 분석은 꺼지고 GPT 링크만 보입니다.
# 서버 전용 키입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
ANTHROPIC_API_KEY=
# 사용자 1명당 하루 분석 횟수 (비용 관리)
AI_DAILY_LIMIT=5

# 구매한 PDF 모든 쪽에 구매자 이메일·주문번호 워터마크를 넣을지 (기본 true)
PDF_WATERMARK=true
