{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reboundlab",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterline",
      "database_id": "6d914011-6dfa-4b96-a07e-ec07bc4709a3",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // 대시보드에서 넣은 변수를 배포 때 지우지 않습니다.
  "keep_vars": true,
  "vars": {
    // 새 신청 이메일 알림 (Formspree 폼 ID, 공개되어도 되는 값)
    "FORMSPREE_FORM_ID": "moejjwqa"
  }
}
